
{
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": [
    "hyprland/workspaces"
],

"modules-center": [
    "wlr/taskbar"
],

"modules-right": [
    "pulseaudio",
    "cpu",
    "memory",
    "network",
    "clock"
],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = {id} })'",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4]
        },
        "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 24,
    "tooltip": false,
    "on-click": "minimize-raise",
    "on-click-middle": "close",
    "all-outputs": false
},
        "workspace-taskbar": {
            "enable": true,
            "icon-size": 22,
            "update-active-window": true,
            "max-icons": 5,
            "on-click-window": "hyprctl dispatch 'hl.dsp.focus({ window = \"address:{address}\" })'"
        }
    },

    "hyprland/window": {
    "format": "{}",
    "icon": true,
    "icon-size": 20,
    "max-length": 40
},

    "cpu": {
        "format": "CPU {usage}%"
    },

    "memory": {
        "format": "RAM {}%"
    },

    "pulseaudio": {
        "format": "VOL {volume}%"
    },

    "network": {
        "format-wifi": "WIFI {essid}",
        "format-ethernet": "LAN",
        "format-disconnected": "OFF"
    },

    "clock": {
        "format": "{:%H:%M}"
    }
}

